# ── Required ──────────────────────────────────────────────────────────────
# Your OpenRouter API key (https://openrouter.ai/keys).
OPENROUTER_API_KEY=sk-or-v1-...

# ── Model ─────────────────────────────────────────────────────────────────
# The OpenRouter image model to use.
#   Chat-style image model (NanoBanana / Gemini Flash Image): google/gemini-2.5-flash-image
#   Pure image model (Flux):                                   black-forest-labs/flux.2-pro
IMAGE_MODEL=google/gemini-2.5-flash-image

# How the model is driven:
#   auto  -> detect from the model id (Flux/Recraft/Seedream/... = image, rest = chat)
#   chat  -> chat model that emits images   -> modalities ["image", "text"]
#   image -> pure image-generation model    -> modalities ["image"]
IMAGE_MODEL_TYPE=auto

# ── Storage ───────────────────────────────────────────────────────────────
# Generated images are stored and shared via a public link.
#
# Local disk (default): images are served by this server at /images/<file>.
# Set PUBLIC_BASE_URL to the public URL where this server is reachable so the
# links are stable (e.g. https://images.example.com). Leave empty to derive it
# from the request host (fine for local testing).
PUBLIC_BASE_URL=

# Cloudflare R2 (optional, PREFERRED when configured): if the R2_* variables
# below are set, images are uploaded to R2 instead of local disk and served
# directly by Cloudflare. Setting any R2_ variable enables R2 and requires the
# full set (R2_BUCKET, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY,
# R2_PUBLIC_BASE_URL and either R2_ACCOUNT_ID or R2_ENDPOINT).
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Either set the account id (endpoint is derived) ...
R2_ACCOUNT_ID=
# ... or provide the full S3 endpoint explicitly:
R2_ENDPOINT=
# Public base URL of the bucket / custom domain used to build image links,
# e.g. https://images.example.com or https://pub-xxxx.r2.dev
R2_PUBLIC_BASE_URL=
# Optional key prefix (folder) for stored objects.
R2_KEY_PREFIX=

# ── Server / optional ─────────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0

# Where images are stored on disk (a Docker volume in production).
IMAGE_STORAGE_DIR=./data/images

# Optional bearer token that clients must send on POST /mcp.
# Recommended for any public deployment. NOTE: Claude's custom-connector flow
# uses OAuth and cannot send a static bearer token, so leave this empty for the
# Claude connector and protect the endpoint at the network layer instead.
MCP_AUTH_TOKEN=

# --- Security / hardening (sensible defaults) -----------------------------
# Number of reverse-proxy hops to trust for X-Forwarded-* (real client IP for
# rate limiting). Default 1 = a single proxy. Use "false" for no proxy. Avoid
# "true" (permissive — allows X-Forwarded-For spoofing).
TRUST_PROXY=1
# Max accepted request body size (raise if you send large reference images).
MAX_BODY_SIZE=25mb
# Per-IP rate limiting on the API (0 disables it).
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
# Optional comma-separated allow-list of request Origins for POST /mcp.
# Leave empty to allow all (Claude's server-to-server calls send no Origin).
ALLOWED_ORIGINS=

# --- Reference-image uploads (create_upload_url / PUT /uploads/:token) -----
# HMAC secret signing short-lived upload URLs. Set a long random value in
# production so upload URLs survive restarts and work across instances.
# Auto-generated (ephemeral) if left empty.
UPLOAD_SIGNING_SECRET=
# Lifetime of an upload URL, in seconds.
UPLOAD_URL_TTL_SECONDS=600
# Max accepted size for a single reference-image upload.
MAX_UPLOAD_SIZE=15mb

# --- OAuth (required for the Claude custom connector) ----------------------
# Claude authenticates connectors via OAuth + dynamic client registration.
# Set OAUTH_PASSWORD to enable the built-in OAuth 2.1 authorization server.
# On the consent screen Claude opens, you enter this password to authorize.
OAUTH_PASSWORD=
# Public HTTPS URL of THIS server (the OAuth issuer / resource id).
# Falls back to PUBLIC_BASE_URL if unset. Must be https in production.
OAUTH_ISSUER_URL=
# HMAC secret used to sign tokens. Set a long random value in production so
# tokens survive restarts and are shared across instances. Auto-generated
# (ephemeral) if left empty.
OAUTH_SIGNING_SECRET=
# Token lifetimes in seconds (defaults: 1h access, 30d refresh).
OAUTH_ACCESS_TOKEN_TTL=3600
OAUTH_REFRESH_TOKEN_TTL=2592000

# Optional generation defaults applied when a request omits them.
DEFAULT_ASPECT_RATIO=
DEFAULT_IMAGE_SIZE=

# OpenRouter request timeout in milliseconds.
REQUEST_TIMEOUT_MS=120000
